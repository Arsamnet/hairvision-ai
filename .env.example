APP_NAME=HairVision
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://clinic1.hairvision-ai.test
APP_VERSION=1.0.0

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
HAIRVISION_LEAD_SESSION_COOKIE=hairvision_lead_session
HAIRVISION_CLINIC_ADMIN_SESSION_COOKIE=hairvision_clinic_admin_session
HAIRVISION_PLATFORM_ADMIN_SESSION_COOKIE=hairvision_platform_admin_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

HAIRVISION_DEFAULT_AI_PROVIDER=sample_image
HAIRVISION_SUPER_ADMIN_NAME="مدیر سیستم HairVision"
