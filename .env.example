APP_NAME=HairVision
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://clinic1.hairvision-ai.test
APP_VERSION=1.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

HAIRVISION_DEFAULT_AI_PROVIDER=sample_image
HAIRVISION_SAMPLE_IMAGE_3_MONTHS=sample-results/3-months.jpg
HAIRVISION_SAMPLE_IMAGE_6_MONTHS=sample-results/6-months.jpg
HAIRVISION_SAMPLE_IMAGE_12_MONTHS=sample-results/12-months.jpg
HAIRVISION_SAMPLE_IMAGE_FALLBACK=sample-results/hairvision-sample-result.jpg
HAIRVISION_DEBUG_FAST_SAMPLES=true
HAIRVISION_OTP_MAX_REQUESTS=5
HAIRVISION_OTP_DECAY_SECONDS=600
HAIRVISION_OTP_MAX_ATTEMPTS=5
HAIRVISION_ADMIN_OTP_MAX_REQUESTS=5
HAIRVISION_ADMIN_OTP_DECAY_SECONDS=600
HAIRVISION_ADMIN_OTP_MAX_VERIFY_ATTEMPTS=5
HAIRVISION_ADMIN_OTP_VERIFY_DECAY_SECONDS=600
HAIRVISION_ADMIN_OTP_MAX_ATTEMPTS=5

SMS_FAKE_ENABLED=true
SMS_HTTP_TIMEOUT=10
SMS_STORE_MESSAGE_BODY=false
SMS_MESSAGE_PREVIEW_LENGTH=80
SMS_MELLI_PAYAMAK_ENDPOINT=https://rest.payamak-panel.com/api/SendSMS/SendSMS
SMS_KAVENEGAR_ENDPOINT=https://api.kavenegar.com/v1
SMS_IPPANEL_ENDPOINT=https://edge.ippanel.com/v1/api/send
SMS_IPPANEL_FROM_NUMBER=
SMS_IPPANEL_OTP_PATTERN_CODE=s5jh64gwzlk0jf3
SMS_IR_ENDPOINT=https://api.sms.ir/v1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
