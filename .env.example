APP_NAME=HairVision
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://hairvision-ai.test
APP_VERSION=1.0.0

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hairvision
DB_USERNAME=root
DB_PASSWORD=

DB_QUEUE_CONNECTION=mysql
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=420

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

HAIRVISION_LEAD_SESSION_COOKIE=hairvision_lead_session
HAIRVISION_CLINIC_ADMIN_SESSION_COOKIE=hairvision_clinic_admin_session
HAIRVISION_PLATFORM_ADMIN_SESSION_COOKIE=hairvision_platform_admin_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Redis queue behavior
# Must be greater than the queue worker timeout to avoid duplicate processing.
REDIS_QUEUE_RETRY_AFTER=1200

HAIRVISION_DEFAULT_AI_PROVIDER=sample_image
HAIRVISION_DEFAULT_SMS_PROVIDER=local

HAIRVISION_SUPER_ADMIN_NAME="مدیر کل"
HAIRVISION_SUPER_ADMIN_EMAIL=superadmin@example.com
HAIRVISION_SUPER_ADMIN_PHONE=09129999999

HAIRVISION_API_PER_PAGE=15
HAIRVISION_API_MAX_PER_PAGE=100
HAIRVISION_API_IMAGE_MAX_DIMENSION=1024
HAIRVISION_API_IMAGE_JPEG_QUALITY=85
HAIRVISION_API_IMAGE_FORMAT=jpg

HAIRVISION_SAMPLE_IMAGE_3_MONTHS=sample-results/two-weeks.jpg
HAIRVISION_SAMPLE_IMAGE_6_MONTHS=sample-results/intermediate_regrowth.jpg
HAIRVISION_SAMPLE_IMAGE_12_MONTHS=sample-results/final_result.jpg
HAIRVISION_SAMPLE_IMAGE_FALLBACK=sample-results/hairvision-sample-result.jpg

# Exclusive step debugger setting
HAIRVISION_DEBUG_FAST_SAMPLES=true
HAIRVISION_DEBUG_STEP_DATABASE_QUERIES=true
HAIRVISION_DEBUG_STEP_MODEL_EVENTS=true
HAIRVISION_DEBUG_STEP_SLOW_QUERY_MS=0

HAIRVISION_OTP_MAX_REQUESTS=5
HAIRVISION_OTP_DECAY_SECONDS=600
HAIRVISION_OTP_MAX_ATTEMPTS=5
HAIRVISION_OTP_EXPIRES_SECONDS=120

HAIRVISION_ADMIN_OTP_MAX_REQUESTS=5
HAIRVISION_ADMIN_OTP_DECAY_SECONDS=600
HAIRVISION_ADMIN_OTP_MAX_VERIFY_ATTEMPTS=5
HAIRVISION_ADMIN_OTP_VERIFY_DECAY_SECONDS=600
HAIRVISION_ADMIN_OTP_MAX_ATTEMPTS=5
HAIRVISION_ADMIN_OTP_EXPIRES_SECONDS=300

# IPPanel SMS gateway used for system OTP and notifications.
# For production, set HAIRVISION_DEFAULT_SMS_PROVIDER=ippanel and fill these values.
HAIRVISION_IPPANEL_AUTHORIZATION_TOKEN=
HAIRVISION_IPPANEL_FROM_NUMBER=
HAIRVISION_IPPANEL_OTP_PATTERN_CODE=
HAIRVISION_IPPANEL_OTP_PATTERN_VARIABLE=verification-code
HAIRVISION_IPPANEL_ENDPOINT_URL=https://edge.ippanel.com/v1/api/send
HAIRVISION_IPPANEL_TIMEOUT_SECONDS=8
HAIRVISION_IPPANEL_CONNECT_TIMEOUT_SECONDS=3

# Generation frontend behavior
# Polling should not fail the generation. Soft timeout only changes the UI message.
HAIRVISION_GENERATION_POLL_INTERVAL_MS=5000
HAIRVISION_GENERATION_MESSAGE_INTERVAL_MS=10000
HAIRVISION_GENERATION_SOFT_TIMEOUT_MS=120000
HAIRVISION_GENERATION_MAX_WAIT_MS=900000
HAIRVISION_GENERATION_ALLOW_BACKGROUND_COMPLETION=true

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
