# HairVision shared-cPanel production template.
# Copy to the repository-root .env on the server, fill every blank secret, and
# keep this template itself free of production credentials.

APP_NAME=HairVision
APP_ENV=production
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=https://hairvision.ir
# Version 2.1.0 release metadata and environment-managed runtime settings.
APP_VERSION=2.1.0

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

AUTH_GUARD=web
AUTH_MODEL=App\Models\User
AUTH_PASSWORD_BROKER=users
AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
AUTH_PASSWORD_TIMEOUT=10800

# Daily logs avoid an indefinitely growing single log on shared hosting.
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_USERNAME="${APP_NAME}"
LOG_SLACK_EMOJI=:boom:
LOG_PAPERTRAIL_HANDLER=Monolog\Handler\SyslogUdpHandler
PAPERTRAIL_URL=
PAPERTRAIL_PORT=
LOG_STDERR_FORMATTER=null
LOG_SYSLOG_FACILITY=8

# cPanel commonly prefixes database/user names with the account name.
DB_CONNECTION=mysql
DB_URL=
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=hairvision_hairvision
DB_USERNAME=hairvision_hairvision
DB_PASSWORD=
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_FOREIGN_KEYS=true
DB_SSLMODE=prefer
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=false
MYSQL_ATTR_SSL_CA=

DB_QUEUE_CONNECTION=mysql
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
# Must be greater than HAIRVISION_QUEUE_WORKER_TIMEOUT.
DB_QUEUE_RETRY_AFTER=1200

DB_CACHE_CONNECTION=mysql
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=mysql
DB_CACHE_LOCK_TABLE=cache_locks

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_CONNECTION=mysql
SESSION_TABLE=sessions
SESSION_STORE=null
SESSION_COOKIE=hairvision-session
SESSION_PATH=/
# Keep null so visitor and admin sessions remain host-scoped.
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

HAIRVISION_LEAD_SESSION_COOKIE=hairvision_lead_session
HAIRVISION_CLINIC_ADMIN_SESSION_COOKIE=hairvision_clinic_admin_session
HAIRVISION_PLATFORM_ADMIN_SESSION_COOKIE=hairvision_platform_admin_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
CACHE_PREFIX=hairvision-production-cache-
CACHE_STORAGE_DISK=local
CACHE_STORAGE_PATH=framework/cache/data

MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
MEMCACHED_PERSISTENT_ID=
MEMCACHED_USERNAME=null
MEMCACHED_PASSWORD=null

BEANSTALKD_QUEUE_HOST=localhost
BEANSTALKD_QUEUE=default
BEANSTALKD_QUEUE_RETRY_AFTER=90

SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/your-account-id
SQS_QUEUE=default
SQS_SUFFIX=

# Redis values are ready for a later move to Redis/Horizon, but remain unused
# while database cache, session, and queue drivers are selected above.
REDIS_CLIENT=predis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_CLUSTER=redis
REDIS_PREFIX=hairvision-production-database-
REDIS_PERSISTENT=false
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=1200
REDIS_QUEUE_BLOCK_FOR=1

HORIZON_NAME=hairvision-production
HORIZON_DOMAIN=null
HORIZON_PATH=horizon
HORIZON_PREFIX=hairvision_production_horizon:
HORIZON_MAX_PROCESSES=2
HORIZON_SLEEP_SECONDS=1

# Long-running image jobs: provider timeout is 1000s and worker timeout is 1020s.
HAIRVISION_QUEUE_WORKER_TIMEOUT=1020

# Image generation queue and worker watchdog. retry_after must remain greater
# than IMAGE_WORKER_TIMEOUT, which must remain greater than the provider timeout.
IMAGE_QUEUE_CONNECTION=database
IMAGE_QUEUE_NAME=ai-generation
IMAGE_WORKER_MODE=detached
IMAGE_WORKER_COUNT=2
IMAGE_WORKER_TIMEOUT=1020
IMAGE_WORKER_TRIES=3
IMAGE_WORKER_MAX_JOBS=250
IMAGE_WORKER_MAX_TIME=3600
IMAGE_WORKER_MEMORY=256
IMAGE_WORKER_STALE_SECONDS=1080
IMAGE_PROVIDER_MAX_CONCURRENCY=2
IMAGE_PROVIDER_CONNECT_TIMEOUT=50
IMAGE_PROVIDER_REQUEST_TIMEOUT=1000
HAIRVISION_OPENAI_CONCURRENCY_LIMIT=2
IMAGE_PROVIDER_CAPACITY_DELAY_MIN_SECONDS=3
IMAGE_PROVIDER_CAPACITY_DELAY_MAX_SECONDS=8
IMAGE_RESULT_RETENTION_HOURS=720
IMAGE_ACTIVE_SESSION_RETENTION_MINUTES=120
IMAGE_POLL_INITIAL_INTERVAL_MS=1500
IMAGE_POLL_MAX_INTERVAL_MS=15000

# Shared-cPanel fallback. Disable this if Horizon is started persistently.
HAIRVISION_CPANEL_QUEUE_CRON_ENABLED=true
HAIRVISION_CPANEL_QUEUE_CONNECTION=database
HAIRVISION_CPANEL_QUEUE_NAMES=ai-generation,default
# Two lanes allow two independent OpenAI generations when the account permits it.
HAIRVISION_CPANEL_QUEUE_PROCESSES=2
HAIRVISION_CPANEL_QUEUE_WINDOW_SECONDS=58
HAIRVISION_CPANEL_QUEUE_SLEEP_SECONDS=1
HAIRVISION_CPANEL_QUEUE_OVERLAP_MINUTES=30

HAIRVISION_DEFAULT_SERVICE_KEY=hair_transplant
# Production forcibly rejects the debug/test SMS gateway even if this flag is changed.
HAIRVISION_DEFAULT_SMS_PROVIDER=ippanel
HAIRVISION_DEBUG_SMS_ENABLED=false
HAIRVISION_PREPARING_IMAGE_MESSAGE="در حال آماده سازی تصویر و ساخت نتایج نمونه هستیم. لطفا چند لحظه صبر کنید."

HAIRVISION_SUPER_ADMIN_NAME="مدیر کل"
HAIRVISION_SUPER_ADMIN_EMAIL=admin@hairvision.ir
HAIRVISION_SUPER_ADMIN_PHONE=09120000000

HAIRVISION_API_PER_PAGE=15
HAIRVISION_API_MAX_PER_PAGE=100
HAIRVISION_API_IMAGE_MAX_DIMENSION=800
HAIRVISION_API_IMAGE_JPEG_QUALITY=85
HAIRVISION_API_IMAGE_FORMAT=jpg

HAIRVISION_SAMPLE_IMAGE_TWO_WEEKS=sample-results/two-weeks.jpg
HAIRVISION_SAMPLE_IMAGE_INTERMEDIATE_REGROWTH=sample-results/intermediate_regrowth.jpg
HAIRVISION_SAMPLE_IMAGE_FINAL_RESULT=sample-results/final_result.jpg
HAIRVISION_SAMPLE_IMAGE_EYEBROW_FINAL_RESULT=sample-results/eyebrow_final_result.jpg
HAIRVISION_SAMPLE_IMAGE_FALLBACK=sample-results/hairvision-sample-result.jpg

# Legacy aliases retained for existing deployments.
HAIRVISION_SAMPLE_IMAGE_3_MONTHS=sample-results/two-weeks.jpg
HAIRVISION_SAMPLE_IMAGE_6_MONTHS=sample-results/intermediate_regrowth.jpg
HAIRVISION_SAMPLE_IMAGE_12_MONTHS=sample-results/final_result.jpg

# Non-production seed placeholders only. Never put real provider keys here.
HAIRVISION_DEMO_GAPGPT_API_KEY=seed-demo-gapgpt-api-key
HAIRVISION_DEMO_OPENAI_API_KEY=seed-demo-openai-api-key

# Production must not use synchronous sample shortcuts or detailed debug traces.
HAIRVISION_DEBUG_FAST_SAMPLES=false
HAIRVISION_DEBUG_STEP_DATABASE_QUERIES=false
HAIRVISION_DEBUG_STEP_MODEL_EVENTS=false
HAIRVISION_DEBUG_STEP_SLOW_QUERY_MS=250

HAIRVISION_OTP_MAX_REQUESTS=5
HAIRVISION_OTP_DECAY_SECONDS=600
HAIRVISION_OTP_MAX_ATTEMPTS=5
HAIRVISION_OTP_EXPIRES_SECONDS=120

HAIRVISION_ADMIN_OTP_MAX_REQUESTS=5
HAIRVISION_ADMIN_OTP_DECAY_SECONDS=600
HAIRVISION_ADMIN_OTP_MAX_VERIFY_ATTEMPTS=5
HAIRVISION_ADMIN_OTP_VERIFY_DECAY_SECONDS=600
HAIRVISION_ADMIN_OTP_MAX_ATTEMPTS=5
HAIRVISION_ADMIN_OTP_EXPIRES_SECONDS=300

# Fill these on the server. Enable/default the DB gateway from the dashboard
# only after its credentials and delivery policy have been verified.
HAIRVISION_IPPANEL_AUTHORIZATION_TOKEN=
HAIRVISION_IPPANEL_FROM_NUMBER=
HAIRVISION_IPPANEL_OTP_PATTERN_CODE=
HAIRVISION_IPPANEL_OTP_PATTERN_VARIABLE=verification-code
HAIRVISION_IPPANEL_ENDPOINT_URL=https://edge.ippanel.com/v1/api/send
HAIRVISION_IPPANEL_TIMEOUT_SECONDS=8
HAIRVISION_IPPANEL_CONNECT_TIMEOUT_SECONDS=3
HAIRVISION_IPPANEL_SEND_ATTEMPTS=3
HAIRVISION_IPPANEL_RETRY_DELAY_MILLISECONDS=200

HAIRVISION_GENERATION_QUEUE_CONNECTION=database
HAIRVISION_GENERATION_QUEUE_NAME=ai-generation
HAIRVISION_GENERATION_RESERVATION_STALE_SECONDS=300
HAIRVISION_GENERATION_PROCESSING_REVIEW_SECONDS=1800
HAIRVISION_PROVIDER_RATE_LIMIT_RETRIES=3
HAIRVISION_PROVIDER_RATE_LIMIT_DELAY_SECONDS=30
HAIRVISION_PROVIDER_RATE_LIMIT_MAX_DELAY_SECONDS=300
# Only DNS/TCP connect failures proven to occur before HTTP delivery are retried.
HAIRVISION_OPENAI_CONNECTION_RETRIES=2
HAIRVISION_OPENAI_CONNECTION_RETRY_DELAY_SECONDS=2
HAIRVISION_OPENAI_CONNECTION_RETRY_MAX_DELAY_SECONDS=20
HAIRVISION_OPENAI_CONNECTION_RETRY_JITTER_SECONDS=2
HAIRVISION_PROVIDER_FAILURE_THRESHOLD=5
HAIRVISION_PROVIDER_FAILURE_COOLDOWN_SECONDS=300
HAIRVISION_GENERATION_POLL_INTERVAL_MS=5000
HAIRVISION_GENERATION_MESSAGE_INTERVAL_MS=10000
HAIRVISION_GENERATION_SOFT_TIMEOUT_MS=120000

# Keep log until real cPanel SMTP credentials are configured.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_URL=null
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_EHLO_DOMAIN=hairvision.ir
MAIL_FROM_ADDRESS=no-reply@hairvision.ir
MAIL_FROM_NAME="${APP_NAME}"
MAIL_LOG_CHANNEL=null
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"

POSTMARK_API_KEY=
POSTMARK_MESSAGE_STREAM_ID=outbound
RESEND_API_KEY=
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

DYNAMODB_CACHE_TABLE=cache
DYNAMODB_ENDPOINT=

SANCTUM_STATEFUL_DOMAINS=hairvision.ir
SANCTUM_TOKEN_PREFIX=

VITE_APP_NAME="${APP_NAME}"
